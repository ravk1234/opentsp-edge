# OpenTSP RTL verification: run systolic tile against generated Python vectors.
# Run from repo root with: make -C tests_rtl -f Makefile.systolic_tile_vectors

SIM ?= verilator
TOPLEVEL_LANG ?= verilog

REPO_ROOT := $(abspath $(CURDIR)/..)
VERILOG_SOURCES := $(REPO_ROOT)/rtl/systolic_tile_2x2.sv

TOPLEVEL := systolic_tile_2x2
MODULE := test_systolic_tile_vectors

SIM_BUILD ?= sim_build

EXTRA_ARGS += --trace

include $(shell cocotb-config --makefiles)/Makefile.sim
